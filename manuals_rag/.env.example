APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8600
POSTGRES_DSN=postgresql://manuals:manuals@postgres:5432/manuals_rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
INDEXED_BM25_ENABLED=false
RETRIEVAL_BRANCH_MAX_WORKERS=4
RETRIEVAL_QDRANT_MAX_CONCURRENCY=2
AGENTIC_HOP_MAX_CONCURRENCY=2
AGENTIC_VERIFIER_MAX_CONCURRENCY=2
AGENT_MATRIX_CASE_CONCURRENCY=2
VISUAL_RETRIEVAL_ENABLED=false
VISUAL_RETRIEVAL_MODEL=vidore/colSmol-256M
VISUAL_RETRIEVAL_PREFETCH_LIMIT=40
VISUAL_RETRIEVAL_RESULT_LIMIT=5
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ORIGINALS=manuals-originals
MINIO_BUCKET_ARTIFACTS=manuals-artifacts
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_METADATA_MODEL=qwen3.5:9b
OLLAMA_METADATA_TIMEOUT_SECONDS=300
OLLAMA_METADATA_NUM_BATCH=64
OLLAMA_RETRIEVAL_VERIFIER_NUM_BATCH=64
AGENTIC_RETRIEVAL_ENABLED=false
AGENT_EVIDENCE_GATE_ENABLED=true
AGENTIC_RETRIEVAL_MAX_SECONDS=180
AGENTIC_RETRIEVAL_PLANNER_TIMEOUT_SECONDS=45
AGENTIC_RETRIEVAL_VERIFIER_TIMEOUT_SECONDS=90
AGENTIC_RETRIEVAL_RESULT_LIMIT=10
OLLAMA_ANSWER_MODEL=qwen3.5:9b
OLLAMA_ANSWER_NUM_PREDICT=1024
OLLAMA_EVAL_QUESTION_MODEL=qwen3.5:27b
OLLAMA_EVAL_QUESTION_REVIEWER_MODEL=qwen3.5:9b
OLLAMA_EVAL_QUESTION_REVIEW_ATTEMPTS=3
# Central-first inference fabric. Set the HTTPS/Tailscale gateway URL and the
# per-application credentials when the droplet is deployed. Availability-only
# fallback keeps local Ollama usable during gateway outages; auth/config/model
# errors never fall back silently. Leave the URL blank for direct-local mode.
# Keep credentials in a secret manager or deployment environment, never in the repo or browser.
# Local RAG services submit through the connected node; the node authenticates
# to the central gateway and the RAG containers receive no gateway secrets.
INFERENCE_NODE_BROKER_URL=http://host.docker.internal:8767
INFERENCE_GATEWAY_URL=
INFERENCE_GATEWAY_FALLBACK_ENABLED=true
INFERENCE_GATEWAY_TOKEN=
INFERENCE_GATEWAY_STATE_PATH=/var/lib/manuals-rag-inference/gateway-state.json
INFERENCE_GATEWAY_REQUIRE_NODE_AGENTS=false
INFERENCE_GATEWAY_REQUIRE_APPLICATION_ALLOWLIST=false
INFERENCE_GATEWAY_REQUIRE_APPLICATION_IDENTITY=false
INFERENCE_GATEWAY_ALLOW_PUBLIC_BIND=false
INFERENCE_IDLE_MODEL_TTL_SECONDS=900
INFERENCE_APPLICATION=manuals_rag
INFERENCE_WORKLOAD=
INFERENCE_MODEL_CATALOG_JSON=
INFERENCE_APPLICATION_TOKENS_JSON=
INFERENCE_APPLICATION_TOKEN=
INFERENCE_EXPECTED_NODE_COUNT=2
INFERENCE_HEARTBEAT_TTL_SECONDS=15
INFERENCE_ALLOW_MODEL_PULL=false
INFERENCE_ALLOW_MODEL_EVICTION=false
# Set true only after all callers are routed through the node agent.
INFERENCE_NODE_PROXY_ONLY=false
INFERENCE_NODE_CONFIG_PATH=~/.config/manuals-rag/inference-node.json
INFERENCE_NODE_REQUIRE_PRODUCTION=false
INFERENCE_NODE_ALLOWED_APPLICATIONS=manuals_rag,provis_employee_agent,openclaw
INFERENCE_NODE_ALLOWED_MODEL_PREFIXES=qwen,nomic,bge,mxbai
INFERENCE_NODE_MAX_MODEL_SIZE_BYTES=80000000000
INFERENCE_NODE_MAX_CLOCK_SKEW_SECONDS=60
INFERENCE_NODE_ALLOWED_HOST_SUFFIXES=.ts.net,.tailnet
INFERENCE_ENROLLMENT_ALLOW_LOCAL_ENDPOINTS=false
INFERENCE_NODE_ADVERTISE_URL=
INFERENCE_GATEWAY_ENROLLMENT_TOKEN=
INFERENCE_SETUP_BIND=127.0.0.1
INFERENCE_SETUP_PORT=8766
DOCLING_DEVICE=cuda
DOCLING_ENABLE_TABLE_STRUCTURE=true
DOCLING_ENABLE_OCR=false
DOCLING_FORCE_FULL_PAGE_OCR=false
DOCLING_TABLEFORMER_MODE=accurate
AUTH_MODE=local
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_CLOCK_SKEW_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:8501
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOCAL_ADMIN_TOKEN=admin-token
LOCAL_OPERATOR_TOKEN=operator-token
LOCAL_END_USER_TOKEN=user-token
LOCAL_AUDITOR_TOKEN=auditor-token
DEFAULT_TENANT_ID=local-tenant
DEFAULT_CORPUS_ID=manuals_vendor_keyence
