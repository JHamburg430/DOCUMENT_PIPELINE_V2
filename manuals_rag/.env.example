APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8600
POSTGRES_DSN=postgresql://manuals:manuals@postgres:5432/manuals_rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=falseupdate
MINIO_BUCKET_ORIGINALS=manuals-originals
MINIO_BUCKET_ARTIFACTS=manuals-artifacts
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_METADATA_MODEL=tinyllama:1.1b
OLLAMA_ANSWER_MODEL=qwen3.5:9b
DOCLING_DEVICE=cuda
DOCLING_ENABLE_TABLE_STRUCTURE=true
DOCLING_TABLEFORMER_MODE=accurate
AUTH_MODE=local
LOCAL_ADMIN_TOKEN=admin-token
LOCAL_OPERATOR_TOKEN=operator-token
LOCAL_END_USER_TOKEN=user-token
LOCAL_AUDITOR_TOKEN=auditor-token
DEFAULT_TENANT_ID=local-tenant
DEFAULT_CORPUS_ID=manuals_vendor_keyence
