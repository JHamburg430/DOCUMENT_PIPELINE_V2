# Copy to /etc/manuals-rag/inference-gateway.env and replace placeholders.
# Keep the deployed file root-owned and mode 0600; do not commit real values.
INFERENCE_GATEWAY_TOKEN=<operator-gateway-token-at-least-32-characters>
INFERENCE_GATEWAY_STATE_PATH=/var/lib/manuals-rag-inference/gateway-state.json
INFERENCE_GATEWAY_BIND=127.0.0.1
INFERENCE_GATEWAY_PORT=8780
INFERENCE_GATEWAY_REQUIRE_NODE_AGENTS=true
INFERENCE_GATEWAY_REQUIRE_APPLICATION_ALLOWLIST=true
INFERENCE_GATEWAY_REQUIRE_APPLICATION_IDENTITY=true
INFERENCE_GATEWAY_REQUIRE_ENTRA_ENROLLMENT=false
INFERENCE_GATEWAY_ALLOW_PUBLIC_BIND=false
INFERENCE_APPLICATION_TOKENS_JSON=<secret-manager-supplied-application-token-map>
INFERENCE_MODEL_CATALOG_JSON=<approved-model-catalog-json>
INFERENCE_NODE_ALLOWED_HOST_SUFFIXES=.ts.net,.tailnet
INFERENCE_ENROLLMENT_ALLOW_LOCAL_ENDPOINTS=false
INFERENCE_IDLE_MODEL_TTL_SECONDS=900
# Required when INFERENCE_GATEWAY_REQUIRE_ENTRA_ENROLLMENT=true.
INFERENCE_ENTRA_TENANT_ID=<entra-directory-tenant-id>
INFERENCE_ENTRA_AUDIENCE=<gateway-api-application-id-or-audience>
INFERENCE_ENTRA_CLIENT_ID=<public-client-application-id>
INFERENCE_ENTRA_SCOPE=<gateway-api-scope-or-audience-slash-default>
INFERENCE_ENTRA_ALLOWED_ROLES=<comma-separated-approved-app-roles>
INFERENCE_ENTRA_ALLOWED_GROUPS=<comma-separated-approved-group-ids>
INFERENCE_NODE_DEFAULT_TAILNET=<tailnet-name>
INFERENCE_NODE_DEFAULT_APPLICATIONS=manuals_rag,provis_employee_agent,openclaw
INFERENCE_NODE_DEFAULT_PORT=8765
