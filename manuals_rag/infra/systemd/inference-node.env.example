# Copy to /etc/manuals-rag/inference-node.env and replace placeholders.
# Keep the deployed file root-owned and mode 0600; do not commit real values.
INFERENCE_GATEWAY_URL=http://gateway.tailnet:8780
INFERENCE_NODE_ID=gpu-node-name
INFERENCE_NODE_ADVERTISE_URL=http://100.64.0.20:8765
INFERENCE_NODE_BIND=100.64.0.20
INFERENCE_NODE_PORT=8765
OLLAMA_NODE_URL=http://127.0.0.1:11434
TAILNET_NAME=organization-tailnet
INFERENCE_NODE_PROXY_ONLY=true
INFERENCE_NODE_ALLOWED_APPLICATIONS=manuals_rag,provis_employee_agent,openclaw
INFERENCE_NODE_ALLOWED_MODEL_PREFIXES=qwen,nomic,bge,mxbai
INFERENCE_NODE_MAX_MODEL_SIZE_BYTES=80000000000
INFERENCE_NODE_MAX_CLOCK_SKEW_SECONDS=60
INFERENCE_NODE_CONFIG_PATH=/var/lib/manuals-rag-inference-node/node.json
INFERENCE_NODE_REQUIRE_PRODUCTION=true
